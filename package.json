{
  "name": "oxlint-utils",
  "version": "0.0.0",
  "description": "Useful utils for Oxlint.",
  "homepage": "https://github.com/liangmiQwQ/oxlint-utils#readme",
  "bugs": {
    "url": "https://github.com/liangmiQwQ/oxlint-utils/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangmiQwQ/oxlint-utils.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "release": "bumpp",
    "test": "vp run ctest"
  },
  "devDependencies": {
    "@liangmi/vp-config": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
