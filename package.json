{
  "name": "get-oxlint-rules",
  "version": "0.1.1",
  "description": "Useful utils for Oxlint.",
  "homepage": "https://github.com/liangmiQwQ/get-oxlint-rules#readme",
  "bugs": {
    "url": "https://github.com/liangmiQwQ/get-oxlint-rules/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangmiQwQ/get-oxlint-rules.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "release": "bumpp",
    "test": "vp run ctest"
  },
  "dependencies": {
    "find-cache-dir": "catalog:",
    "tinyexec": "catalog:"
  },
  "devDependencies": {
    "@liangmi/vp-config": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "*"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.10.0"
}
